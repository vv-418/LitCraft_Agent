# LLM (OpenAI-compatible)
LLM_MODEL_ID=your-model-id
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_TIMEOUT=120

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# Chroma / multilingual text embeddings (P2: single bge-m3 collection)
CHROMA_DB_PATH=./storage/chroma
EMBEDDING_MODEL=./models/bge-m3
EMBEDDING_ALLOW_DOWNLOAD=0
# Legacy (unused): EMBEDDING_MODEL_EN / EMBEDDING_MODEL_ZH

# Retrieval: dense (default) | hybrid
RETRIEVAL_MODE=dense
RERANKER_MODEL=./models/bge-reranker-v2-m3
RERANK_TOP_N=50

# True multimodal (CLIP). Missing local model => skip; text RAG unaffected.
MULTIMODAL_ENABLED=1
MULTIMODAL_MODEL=./models/clip-ViT-B-32
MULTIMODAL_ALLOW_DOWNLOAD=0
MULTIMODAL_MAX_IMAGES=24

# Paths：综述 PDF / 插图直接下到 output/{日期}/{主题}/{lit_source,figures}
OUTPUT_PATH=./output

# Optional
# 在线中英译（默认开）。provider=auto|mymemory|google|baidu
TRANSLATE_ONLINE=1
TRANSLATE_PROVIDER=auto
TRANSLATE_TIMEOUT=8
# 百度翻译开放平台（可选；有道等需自接 API，deep-translator 无内置有道）
# BAIDU_TRANSLATE_APPID=
# BAIDU_TRANSLATE_SECRET=
# 站外搜索主题过滤（默认开）；调试对齐官网结果时可设 0
SEARCH_TOPIC_FILTER=1
# HTML 抽正文过短不算成功下载
MIN_HTML_EXTRACT_CHARS=200
# OpenAlex / Crossref 礼貌池（可选邮箱）
# OPENALEX_MAILTO=you@example.com
# Semantic Scholar API Key（请求头 x-api-key；约 1 req/s）
SEMANTIC_SCHOLAR_API_KEY=
# 默认开启 Google Scholar；设 0 可跳过（scholarly 爬取，不是官方 API）
SEARCH_INCLUDE_GOOGLE=1
# GOOGLE_SCHOLAR_PROXY=http://127.0.0.1:10808
